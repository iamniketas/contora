# Corporate values intentionally have no defaults in source control.
SPEECH_API_BASE_URL=
SPEECH_API_TOKEN=
SPEECH_API_MODEL=latest

# Transfer-compatible storage reachable by the ASR inference network.
# Prefer approved corporate storage for sensitive recordings.
CONTORA_VK_UPLOAD_BASE_URL=
CONTORA_VK_UPLOAD_MAX_DAYS=1

CONTORA_VK_HOST=127.0.0.1
CONTORA_VK_PORT=8020
CONTORA_VK_POLL_INTERVAL_SECONDS=5
CONTORA_VK_OPERATION_TIMEOUT_SECONDS=43200
CONTORA_VK_HTTP_CONNECT_TIMEOUT_SECONDS=30
CONTORA_VK_HTTP_READ_TIMEOUT_SECONDS=300

# Contora's managed macOS runtime can be reused for pyannote assets.
CONTORA_SPEECH_RUNTIME_ROOT=
CONTORA_VK_DIARIZATION_DEVICE=auto
# Optional fixed count. Leave empty for automatic speaker counting.
CONTORA_VK_NUM_SPEAKERS=
